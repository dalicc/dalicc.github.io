        "@value": "Record status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#recordStatus"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#ReviewStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How far a library record has come in the editorial review workflow: created, reviewed, approved or audited."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
