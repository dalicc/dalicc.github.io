        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "https://dalicc.net/ns#shareAlikeVersionQualifier"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
