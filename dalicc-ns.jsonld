  {
    "@id": "https://dalicc.net/ns#ruleBasis",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The legal source a default rule or an axiom removal rests on, named in words: a\nstatute and its article, a directive, or a general principle. It is a citation a reader can\ncheck, not a holding and not legal advice."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Rule basis"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/date"
      },
      {
        "@id": "https://dalicc.net/ns#DefaultRule"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#ruleExplanation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Two or three plain sentences that say what a default rule, an axiom removal or a replacement does and why the law it rests on leads there. dalicc:ruleBasis is the citation, this is the reading of it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Rule explanation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#AxiomRemoval"
      },
      {
        "@id": "https://dalicc.net/ns#DefaultRule"
      },
      {
        "@id": "https://dalicc.net/ns#ruleBasis"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added with version 2 of the vocabulary."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by every default rule and every axiom removal of the shipped dependency graphs, and shown next to the rule on the graph pages, in the comparator and in every check result where the rule fired. It is not legal advice."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#ruleStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a default rule or an axiom removal to whether it takes part in reasoning\nby default (dalicc:Adopted) or is written down for review (dalicc:Proposed)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
