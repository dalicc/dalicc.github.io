      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Where the modification departs from the named standard, the license attaches duties that a conforming modification does not carry. Carried by SISSL, whose reciprocity is triggered not by modification but by a modification that departs from the named Standard."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#statementOrigin",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a deontic statement to where it came from: dalicc:FromText,\ndalicc:FromConvention or dalicc:FromDefaultRule. A curated record writes it only to mark a\nstatement as a library convention; the reasoner and the services that build a result write the\nother two."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Statement origin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://dalicc.net/ns#StatementOrigin"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#DefaultRule"
      },
      {
        "@id": "https://dalicc.net/ns#StatementOrigin"
      },
      {
        "@id": "https://dalicc.net/ns#convention"
      },
      {
        "@id": "https://dalicc.net/ns#evidence"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#sublicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Granting a third party rights in the work under a license of the licensee's own, rather than passing on the original license."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sublicense"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/grantUse"
      },
      {
        "@id": "https://dalicc.net/ns#ChangeLicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#closeMatch": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/grantUse"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "The license granted by a licensee to a third party, under the authority of the\nlicense originally granted by a licensor to the licensee."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation and first used by the data in the 2026-09-15 license review: every Creative Commons 2.0 and 3.0 port, the six 4.0 International licenses, the Open Database License and the Open Data Commons Attribution License prohibit it in as many words."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#sublicenseSurvival",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the licenses a licensee has validly granted to third parties survive the end of the licensee's own license."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sublicense survival"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#sublicense"
      },
      {
        "@id": "https://dalicc.net/ns#terminatesOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 11 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#suiGenerisDatabaseRights",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Extracting or reusing all or a substantial part of the contents of a database that the sui generis database right protects."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Extract or reuse a substantial part of a database"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Dataset"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/extract"
      },
      {
        "@id": "https://dalicc.net/ns#databaseRightWaiver"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 8 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#terminatesOnBreach",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the license ends automatically when the licensee fails to comply with it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Terminates on breach"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#curePeriod"
      },
      {
        "@id": "https://dalicc.net/ns#terminationOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 60 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "True says the text carries such a clause; the absence of the property says the text is silent, not that the license survives a breach. The policy quality dalicc:terminationOnBreach names the concept; this property is how a record carries it."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#terminationOnBreach",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/isReplacedBy": [
      {
        "@id": "https://dalicc.net/ns#terminatesOnBreach"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Deprecated; replaced by dalicc:terminatesOnBreach, because the property a record carries says the same thing. The license ends automatically when the licensee breaches it. Licenses differ in what survives the end and in whether compliance reinstates the grant."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Termination on breach (deprecated)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#irrevocable"
      },
      {
        "@id": "https://dalicc.net/ns#patentRetaliationTermination"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "terminationOnBreach"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#testFixture",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#RecordStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record is a fixture used to exercise the composer and the tests, not a\npublished license. Its IRI stays resolvable, and presentation layers leave it out of listings,\nsearch results and counts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Test fixture"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#recordStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "testFixture"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#textAndDataMining",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Analysing the work automatically in digital form to find patterns, trends and correlations in it, including the copies such an analysis makes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Text and data mining"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/extract"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/reproduce"
      },
      {
        "@id": "https://dalicc.net/ns#useForModelTraining"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added with version 2 of the vocabulary so that the mining exceptions can be stated as default rules; not used by any license in the current library. dalicc:useForModelTraining stays the narrower act of training a system on the work."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#trademarkNotice",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Stating that the work is, or contains, a trademark."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Trademark notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "https://dalicc.net/ns#promote"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#historyNote": [
      {
        "@language": "en",
        "@value": "Informs that Licensed Material is a trademark or includes trademark. The license\ndoes not grant permission to use the trade names, trademarks, service marks, or product names of\nthe Licensor, except as required for reasonable and customary use in describing the origin of the\nWork and reproducing the content of the notice file."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; used by 1 license record since 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#translationOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license whose legal text is a translation to the license it\ntranslates. A translation may also be a jurisdiction port, and a jurisdiction port drafted in\nthe same language is not a translation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Translation of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/language"
      },
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/dc/terms/isVersionOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#useForModelTraining",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Using the licensed material to train, validate or tune an automated system that learns from data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Use for model training"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Dataset"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/extract"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Some licenses grant it, some prohibit it and most are silent, in which case no statement is made."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#validityType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license to the kind of validity period it has: dalicc:perpetual, dalicc:specifyDate or dalicc:specifyPeriod."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Validity type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://dalicc.net/ns#ValidityType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Present on 342 of 343 licenses, always with the value dalicc:perpetual."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#variantKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How a record relates to the record it descends from: jurisdiction-port,\ntranslation, version, edition, version-option, exception or rider. The first four name a text\nof the same license adapted, translated or reissued; version-option, exception and rider name\na variant that keeps the base text and changes what it grants or requires, and each of those\nthree carries dalicc:variantOf."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Variant kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      },
      {
        "@id": "https://dalicc.net/ns#translationOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by 304 records: 290 with a parent and 14 version or edition variants whose predecessor the library does not hold."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#variantOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record this record is a version-option, exception or rider variant of.\nThe variant keeps the base text and changes what the base grants or requires: an or-later\nidentifier adds the option of a later version of the same license, an exception lifts one\ncondition for named material, and a rider adds a condition of its own."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
