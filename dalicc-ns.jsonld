[
  {
    "@id": "http://www.w3.org/2002/07/owl#sameAs",
    "@type": [
      "https://dalicc.net/ns#DependencyRelation"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/2002/07/owl#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Same as"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Synonymy: the two actions denote the same act in different vocabularies\n(cc:Attribution sameAs odrl:attribute), so a statement about one is a statement about the other.\n8 statements in the default dependency graph."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/implies",
    "@type": [
      "https://dalicc.net/ns#DependencyRelation"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Action asserts that another Action is not prohibited to enable its operational semantics."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Implies"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Entailment: permitting the subject action necessarily permits the object\naction as well (odrl:modify implies cc:SourceCode). 7 statements in the default dependency\ngraph."
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/odrl/2/includedIn",
    "@type": [
      "https://dalicc.net/ns#DependencyRelation"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Action transitively asserts that another Action that encompasses its operational semantics."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Included in"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Action subsumption: exercising the subject action is a way of exercising the\nobject action, so a permission or prohibition on the object also covers the subject\n(odrl:sell includedIn odrl:commercialize). 23 statements in the default dependency graph."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "DALICC"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "The vocabulary of proprietary terms used by the DALICC license library. It\nextends ODRL 2.2 and the Creative Commons Rights Expression Language with the actions, duty\nactions, clause properties and controlled values that the DALICC licenses require and that\nneither vocabulary provides."
      }
    ],
    "http://purl.org/dc/terms/hasVersion": [
      {
        "@value": "6"
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "http://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-09-23"
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@value": "DALICC"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "DALICC vocabulary"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "dalicc"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Namespace scheme: `https://dalicc.net/ns#` is the canonical, authoritative\nform of every term IRI in this vocabulary. `http://dalicc.net/ns#` (plain HTTP) is the legacy\nform used by the 2022 vocabulary documentation and by a few dependency-graph axioms still held\nin the production triple store; it denotes the same terms but must not be used in new data."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      },
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2002/07/owl#imports": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/"
      }
    ],
    "http://www.w3.org/2002/07/owl#priorVersion": [
      {
        "@id": "http://dalicc.net/ns#"
      },
      {
        "@id": "https://dalicc.net/ns/versions/1"
      },
      {
        "@id": "https://dalicc.net/ns/versions/2"
      },
      {
        "@id": "https://dalicc.net/ns/versions/3"
      },
      {
        "@id": "https://dalicc.net/ns/versions/4"
      },
      {
        "@id": "https://dalicc.net/ns/versions/5"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "6.0"
      }
    ],
    "https://dalicc.net/ns#versionHistory": [
      {
        "@id": "https://dalicc.net/ns/versions"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#Approved",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#ReviewStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The review of the record, including every question it left open, has been signed off by the party responsible for the library."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Approved"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#reviewStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Approved"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#AssetType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The kind of thing a license covers, as the value of dct:type on the\nodrl:AssetCollection an odrl:Set targets. The DALICC library uses dcmitype:Software,\ndcmitype:Dataset and the two asset types this vocabulary defines."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Asset type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Dataset"
      },
      {
        "@id": "http://purl.org/dc/dcmitype/Software"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Read by app/services/vocab.py, which builds the asset-type facet of the library and the target list of the composer from the instances of this class plus the two Dublin Core types."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#Audited",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#ReviewStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record has been checked a second time, independently of the reviewer who last changed it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Audited"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#reviewStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Audited"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#ChangeLicense",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The licensee may change, extend or modify the license terms and replace the\noriginal license with a new one. Where the license carries a share-alike duty for the whole\nwork, this permission must carry the dalicc:compliantLicense duty."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Change license"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/grantUse"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Occurs 318 times as an odrl:Prohibition or odrl:Permission in 317 licenses. When permitted it usually carries the duty dalicc:compliantLicense."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#Created",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#ReviewStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record exists but has not been checked against the text of the license it models."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Created"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#reviewStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "Created"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#CreativeWork",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "https://dalicc.net/ns#AssetType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This asset type comprises any type of literary work that is subject to\ncopyright. It also includes multimedia work that combines various media types such as text,\naudio, images, animations, video and interactive content."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Creative work"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Image"
      },
      {
        "@id": "http://purl.org/dc/dcmitype/InteractiveResource"
      },
      {
        "@id": "http://purl.org/dc/dcmitype/MovingImage"
      },
      {
        "@id": "http://purl.org/dc/dcmitype/Sound"
      },
      {
        "@id": "http://purl.org/dc/dcmitype/Text"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Used as a value of dct:type on the odrl:AssetCollection that an odrl:Set targets, alongside dcmitype:Dataset and dcmitype:Software."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#DependencyRelation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relation between two actions that the DALICC compatibility checker reasons\nover. The DALICC dependency graph (named graph https://dalicc.net/dependencygraph/dg_default)\nconsists exclusively of statements whose predicate is an instance of this class."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Dependency relation"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#DutyAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An action that may be the odrl:action of an odrl:Duty, whether attached\nto one permission or carried by the license as a whole: something the licensee must do."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Duty action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Action"
      },
      {
        "@id": "https://dalicc.net/ns#RuleAction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Read by app/services/vocab.py. An action can be both a rule action and a duty action: dalicc:noWarrantyNotice is a permission on AFL-3.0 and a duty on Frameworx-1.0."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#Hardware",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "https://dalicc.net/ns#AssetType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.net/licenselibrary/CERN-OHL-S-2.0"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A physical product, or the design material from which one is made: schematics,\nlayouts, mechanical drawings, bills of material and the firmware that belongs to them. The open\nhardware licenses govern the design material and reach the product made from it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Hardware"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Software"
      },
      {
        "@id": "https://dalicc.net/ns#CreativeWork"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Used as a value of dct:type on the odrl:AssetCollection that an odrl:Set targets, alongside dcmitype:Software, dcmitype:Dataset and dalicc:CreativeWork. Carried by the three CERN Open Hardware Licence records."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#Jurisdiction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The legal territory in which a license is valid. Values are either a country IRI of the BPI country list or dalicc:worldwide."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Jurisdiction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#jurisdiction"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#LiabilityLimitation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The verbatim text of the limitation-of-liability clause of the license. The work comes with a limitation of liability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Limitation of liability"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Present on 301 of 343 licenses."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#ModifiedWorks",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Distributing a modified version of the work and making it available to the\npublic. The counterpart of cc:DerivativeWorks for alterations that do not amount to a new,\nderivative work."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Modified works"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#DerivativeWorks"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/modify"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Occurs in 320 of 343 licenses as an odrl:Permission."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#PromotionSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The verbatim acknowledgement text that the license requires the licensee to reproduce when promoting a product that contains the work."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Promotion specification"
      }
    ],
