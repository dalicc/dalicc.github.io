      {
        "@id": "https://dalicc.net/ns#textAndDataMining"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added with version 2 of the vocabulary so that the European interoperability exception can be stated as a default rule; not used by any license in the current library."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Narrower than reverse engineering at large: the purpose is interoperability and nothing else."
      }
    ]
  },
