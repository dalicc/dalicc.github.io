    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added on 2026-09-23 with the records for the or-later identifiers, the SPDX exception combinations and the Commons Clause rider. dalicc:jurisdictionPortOf stays the relation for a jurisdiction port."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#versionHistory",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a curated model to the list of its versions. Every version the model\never had stays retrievable there, with the change log that says what was altered, when, by whom\nand on the strength of which finding or decision."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Version history"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/hasVersion"
      },
      {
        "@id": "http://purl.org/dc/terms/modified"
      },
      {
        "@id": "https://dalicc.net/ns#reviewedOn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by every record of the library, by the dependency graph and by this vocabulary. The object dereferences to the version list of that model."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#worldwide",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#Jurisdiction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The license terms are valid throughout the world."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Worldwide"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#jurisdiction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The license is valid in every jurisdiction. Used as the value of cc:jurisdiction where a license is not bound to specific countries."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "worldwide"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The value of cc:jurisdiction on 57 licenses; the other 286 name one or more BPI country IRIs."
      }
    ]
  }
]
