      {
        "@language": "en",
        "@value": "Carried by the Academic Free and Open Software licenses from version 2.0 on, whose Attribution Rights clause asks for the express assent of recipients."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#recipientRegistrationRequest",
