        "@id": "https://dalicc.net/ns#basedOnGraph"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added with version 2 of the vocabulary. No shipped graph replaces a rule of the core graph; the difference-file README shows the syntax."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Read by scripts/build_dependency_graphs.py and shown on the page of a graph under What it replaces."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#reverseEngineerForInteroperability",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Decompiling or otherwise analysing a program only so far as is needed to make an independently created program work with it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
