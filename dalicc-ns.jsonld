      {
        "@language": "en",
        "@value": "Specify period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://schema.org/validFor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Written by the DALICC license composer; no license of the published library uses it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "specifyPeriod"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#standardsConformance",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Keeping a modified version in conformity with an external technical standard\nthe license names. Where the modification departs from that standard, the license attaches duties\nthat a conforming modification does not carry."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Standards conformance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "https://dalicc.net/ns#modificationNotice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by SISSL, whose reciprocity is triggered not by modification but by a modification that departs from the named Standard."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#sublicense",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The license granted by a licensee to a third party, under the authority of the\nlicense originally granted by a licensor to the licensee."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sublicense"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/grantUse"
      },
      {
        "@id": "https://dalicc.net/ns#ChangeLicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation and first used by the data in the 2026-09-15 license review: every Creative Commons 2.0 and 3.0 port, the six 4.0 International licenses, the Open Database License and the Open Data Commons Attribution License prohibit it in as many words."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#sublicenseSurvival",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the licenses a licensee has validly granted to third parties survive\nthe termination of the licensee's own license."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sublicense survival"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#sublicense"
      },
      {
        "@id": "https://dalicc.net/ns#terminatesOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 11 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#suiGenerisDatabaseRights",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Exercising the database right that protects a substantial investment in\nobtaining, verifying or presenting the contents of a database, separately from any copyright\nin the database or in its contents."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sui generis database rights"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Dataset"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/extract"
      },
      {
        "@id": "https://dalicc.net/ns#databaseRightWaiver"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 8 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#terminatesOnBreach",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the license ends automatically when the licensee fails to comply with\nit. True says the text carries such a clause; the absence of the property says the text is silent,\nnot that the license survives a breach."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Terminates on breach"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#curePeriod"
      },
      {
        "@id": "https://dalicc.net/ns#terminationOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 60 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The policy quality dalicc:terminationOnBreach names the concept; this property is how a record carries it."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#terminationOnBreach",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The license ends automatically when the licensee breaches it. Licenses\ndiffer in what survives the end and in whether compliance reinstates the grant."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Termination on breach"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#irrevocable"
      },
      {
        "@id": "https://dalicc.net/ns#patentRetaliationTermination"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "terminationOnBreach"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#testFixture",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#RecordStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record is a fixture used to exercise the composer and the tests, not a\npublished license. Its IRI stays resolvable, and presentation layers leave it out of listings,\nsearch results and counts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Test fixture"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#recordStatus"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "testFixture"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#trademarkNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Informs that Licensed Material is a trademark or includes trademark. The license\ndoes not grant permission to use the trade names, trademarks, service marks, or product names of\nthe Licensor, except as required for reasonable and customary use in describing the origin of the\nWork and reproducing the content of the notice file."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Trademark notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "https://dalicc.net/ns#promote"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; used by 1 license record since 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#translationOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license whose legal text is a translation to the license it\ntranslates. A translation may also be a jurisdiction port, and a jurisdiction port drafted in\nthe same language is not a translation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Translation of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/language"
      },
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/dc/terms/isVersionOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#useForModelTraining",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Using the licensed material to train, validate or tune an automated\nsystem that learns from data. Some licenses grant it, some prohibit it and most are silent,\nin which case no statement is made."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Use for model training"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/dcmitype/Dataset"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/extract"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#validityType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license to the kind of validity period it has. Specify your license period by either giving a start date and an end date or by defining a validity period; where this does not apply, choose dalicc:perpetual for an indefinite period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Validity type"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://dalicc.net/ns#ValidityType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Present on 342 of 343 licenses, always with the value dalicc:perpetual."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#variantKind",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How a record relates to the record it descends from: jurisdiction-port,\ntranslation, version, edition, version-option, exception or rider. The first four name a text\nof the same licence adapted, translated or reissued; version-option, exception and rider name\na variant that keeps the base text and changes what it grants or requires, and each of those\nthree carries dalicc:variantOf."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Variant kind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      },
      {
        "@id": "https://dalicc.net/ns#translationOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by 304 records: 290 with a parent and 14 version or edition variants whose predecessor the library does not hold."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#variantOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The record this record is a version-option, exception or rider variant of.\nThe variant keeps the base text and changes what the base grants or requires: an or-later\nidentifier adds the option of a later version of the same licence, an exception lifts one\ncondition for named material, and a rider adds a condition of its own."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Variant of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#exceptedCombination"
      },
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      },
      {
        "@id": "https://dalicc.net/ns#variantKind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/dc/terms/relation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added on 2026-09-23 with the records for the or-later identifiers, the SPDX exception combinations and the Commons Clause rider. dalicc:jurisdictionPortOf stays the relation for a jurisdiction port."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#versionHistory",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a curated model to the list of its versions. Every version the model\never had stays retrievable there, with the change log that says what was altered, when, by whom\nand on the strength of which finding or decision."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Version history"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/hasVersion"
      },
      {
        "@id": "http://purl.org/dc/terms/modified"
      },
      {
        "@id": "https://dalicc.net/ns#reviewedOn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by every record of the library, by the dependency graph and by this vocabulary. The object dereferences to the version list of that model."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#worldwide",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#Jurisdiction"
    ],
