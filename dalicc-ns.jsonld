  {
    "@id": "https://dalicc.net/ns#royalityFree",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/isReplacedBy": [
      {
        "@id": "https://dalicc.net/ns#royaltyFree"
      }
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Refers to the right to use copyright material or intellectual property without\nthe need to pay royalties or license fees for each use, per each copy or volume sold or some time\nperiod of use or sales."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Royalty free (deprecated spelling)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#royaltyFree"
      }
    ],
    "http://www.w3.org/2002/07/owl#deprecated": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#boolean",
        "@value": true
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "https://dalicc.net/ns#royaltyFree"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Misspelling of \"royalty\" published in the 2022 DALICC vocabulary documentation. The\nIRI is kept so that data written against the published documentation still dereferences; use\ndalicc:royaltyFree in new data."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "royalityFree"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#royaltyCollectionReserved",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The licensor keeping the right to collect a royalty for uses of the work,\nwhether individually or through a collecting society. Where the license waives that right\ninstead, the statement is absent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
