  {
    "@id": "https://dalicc.net/ns#shareAlikeVersionQualifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Which outgoing licenses a share-alike condition accepts, as a short literal,\nfor example the same license, a later version of it, another jurisdiction port with the same\nlicense elements, or a license declared compatible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
