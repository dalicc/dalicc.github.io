        "@id": "https://dalicc.net/ns#addStatement"
      },
      {
        "@id": "https://dalicc.net/ns#chargeOffer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#attributionNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Notify the attributes of License Material."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Attribution notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Attribution"
      },
      {
        "@id": "http://creativecommons.org/ns#attributionName"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/attribute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library; the library uses cc:Attribution instead."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#chargeDistributionFee",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The distribution of the Licensed Material is provided on a costly basis."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Charge distribution fee"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      },
      {
        "@id": "https://dalicc.net/ns#chargeLicenseFee"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The licensee is allowed to charge a distribution fee, that is, a fee covering the act of providing the work to a third party."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#chargeLicenseFee",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Licensed Material is available for use at monetary cost."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Charge license fee"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#CommercialUse"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/commercialize"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/sell"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The licensee is allowed to charge a fee for granting a license to the work, that is, to generate revenue from sub-licensing rather than from distribution alone."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The dependency graph states that this action implies odrl:commercialize and odrl:sell and is included in odrl:transfer."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#chargeOffer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Assignee may charge a fee for the physical act of transferring a copy, and\nyou may at your option offer warranty protection in exchange for a fee."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Charge offer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#attachoffer"
      },
      {
        "@id": "https://dalicc.net/ns#chargeDistributionFee"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#compatibleLicenseTest",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The test a license states for deciding whether another license is compatible\nwith it, as a short literal: a named list, an approval by a body, or a comparison of the level of\nreciprocity. The list itself is quoted in dalicc:additionalClauses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compatible license test"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "https://dalicc.net/ns#ChangeLicense"
      },
      {
        "@id": "https://dalicc.net/ns#compliantLicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 12 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#compliantLicense",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The replacement license chosen by the licensee must remain compliant with the terms of the original license. Attached as an odrl:Duty to a dalicc:ChangeLicense permission."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Use a compliant license"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "https://dalicc.net/ns#ChangeLicense"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#composedOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license that is a stack of separate agreements to one of the\nagreements it is made of. A licensee of the stack must comply with every one of them, so the\ncompatibility answer for the stack is the conjunction of the answers for its parts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Composed of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/hasPart"
      },
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by Python-2.0.1, which is four agreements published as one license."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#computationalUseOnly",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Using the work only as the input of a computation: analysis, training,\ntesting or the production of a result, as against publishing or performing the work itself.\nWhere a license carries this term as a duty the licensee may make no other use."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Computational use only"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#fieldOfUseRestriction"
      },
      {
        "@id": "https://dalicc.net/ns#useForModelTraining"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by C-UDA-1.0, whose section 2 binds the licensee to use the data solely for Computational Use."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#conditionalAddLimitation",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Adding a further condition to the license terms, but only in the narrow\ncircumstances the license names, such as a statute, a judicial order, a regulation or a matter of\nnational security. It is the qualified form of dalicc:addLimitation, which a license either\nallows outright or forbids outright."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Conditional add limitation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#addLimitation"
      },
      {
        "@id": "https://dalicc.net/ns#additionalClauses"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by OSET-PL-2.1, whose section 3.2 allows further conditions only to the extent statute, judicial order, regulation, national security or the public interest requires."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#contradicts",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#SymmetricProperty",
      "https://dalicc.net/ns#DependencyRelation"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Action contradicts with another Action."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Action"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Contradicts"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Action"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "States that two actions cannot both be exercised under one policy: if one\nlicense permits the subject action while another requires or permits the object action, the two\nlicenses are incompatible. This is the relation the DALICC compatibility checker reports as a\nconflicting statement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Asserted once in the default dependency graph: odrl:ensureExclusivity contradicts odrl:commercialize. The pair cc:ShareAlike contradicts odrl:grantUse was removed on 2026-09-15: passing the same terms on is the normal way to satisfy a share-alike condition, not a contradiction of it."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#contributionGrantBack",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Granting the licensor, or every other licensee, a license over the changes\nthe licensee makes, so that the modification can travel back into the original work."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Contribution grant back"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#SourceCode"
      },
      {
        "@id": "https://dalicc.net/ns#sublicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by EUDatagrid, OCLC-2.0 and Vim, whose texts either ask for the changes or grant the steward a license over them."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#covenantNotToSue",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An undertaking by the licensor not to bring a claim over uses made under the\nlicense. It is wider than a patent grant, because it reaches every cause of action the licensor\nmight have, and narrower, because it grants nothing: it only promises not to enforce."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Covenant not to sue"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#patentFree"
      },
      {
        "@id": "https://dalicc.net/ns#patentGrant"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 2 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by the two Microsoft use of data agreements, whose section 2 says the data provider will not sue the licensee or any downstream recipient over the use, modification or distribution of the data."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#curePeriod",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The time a licensee in breach is given to put the breach right before the\nlicense ends, as a short literal such as \"30 days\". The absence of the property beside\ndalicc:terminatesOnBreach says the termination is immediate."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Cure period"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#terminatesOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 19 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#databaseRightWaiver",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The licensor giving up the sui generis database right it holds in the\nlicensed material, so that the conditions of the license do not reach the parts of the work\nprotected by that right alone."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Database right waiver"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#suiGenerisDatabaseRights"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#derivativeDatabaseAccess",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offering the recipients of a derivative database access to the derivative\ndatabase itself, or to a file recording the alterations made to the original."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Derivative database access"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#SourceCode"
      },
      {
        "@id": "https://dalicc.net/ns#suiGenerisDatabaseRights"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#downstreamOffer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Offering every recipient of the work a license on the same terms, directly\nfrom the licensor rather than through the distributing licensee."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Downstream offer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      },
      {
        "@id": "https://dalicc.net/ns#sublicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Defined here so the gap is named; the review applied it to no license record."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#exceptedCombination",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Combining or linking the covered work with the material the exception names\nand conveying the result without the condition the exception lifts. Where this action is\npermitted the exception applies, and dalicc:reciprocityScope says what the condition still\ncovers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Excepted combination"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "https://dalicc.net/ns#exemptedMaterial"
      },
      {
        "@id": "https://dalicc.net/ns#reciprocityScope"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added on 2026-09-23 for the records that model a license with an SPDX exception. dalicc:exemptedMaterial keeps its one meaning, material the grant does not reach at all."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#exemptedMaterial",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Using material that the license expressly carves out of its grant, such as\npersonal data, official insignia, third-party rights or material under a separate license.\nWhere this action is prohibited the grant does not reach that material at all."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Exempted material"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#additionalClauses"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#exportControlNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Complying with the export and import laws that reach the work, and passing\nthe notice of them on to every recipient."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Export control notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "https://dalicc.net/ns#additionalClauses"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by NASA-1.3, RPL-1.1 and RPL-1.5."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#fieldOfUseRestriction",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The field of activity a license confines the licensee to, as a short literal.\nWhere the field is computational use the action dalicc:computationalUseOnly carries the duty and\nthis property names the field."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Field of use restriction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#CommercialUse"
      },
      {
        "@id": "https://dalicc.net/ns#computationalUseOnly"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#governingLaw",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The law that governs the license agreement, as a short literal. It is not the\nterritory in which the grant is valid: a license whose grant is worldwide can still be governed by\nthe law of one state, and cc:jurisdiction carries the territory."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Governing law"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#jurisdiction"
      },
      {
        "@id": "https://dalicc.net/ns#Jurisdiction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 6 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#governmentRightsLimitation",
    "@type": [
      "http://www.w3.org/2002/07/owl#AnnotationProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A clause limiting the rights a government end user acquires in the work, or\nmaking the governing law depend on which government the licensee is."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Government rights limitation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#additionalClauses"
      },
      {
        "@id": "https://dalicc.net/ns#governingLaw"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#includeNoticeFile",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Carrying a named notice file of the original work forward into every\nredistributed copy and into derivative works, in one of the places the license lists."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Include notice file"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "https://dalicc.net/ns#attributionNotice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#irrevocable",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The license cannot be terminated for any reason or only that the license cannot\nbe terminated for convenience, but still may be terminated for breach."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Irrevocable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "irrevocable"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#jurisdictionPortOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a license adapted to one legal system to the license it was adapted\nfrom. The two licenses grant substantially the same rights; they differ in the law they are\ndrafted against, in the language of the legal text and in the clauses that quote it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Jurisdiction port of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#jurisdiction"
      },
      {
        "@id": "https://dalicc.net/ns#translationOf"
      },
      {
        "@id": "https://dalicc.net/ns#variantKind"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://purl.org/dc/terms/isVersionOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by 290 records. Where the library holds no record of the port's own version, the parent is the nearest version the library does hold, so the relation can carry a version difference as well as a jurisdiction difference; dalicc:licenseVersion names the version of the port itself."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#licenseOwner",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The name of the party that owns the rights in the licensed work, as the licensor gave it when composing the license."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "License owner"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/publisher"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/assigner"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Written by the DALICC license composer onto user-composed licenses; no license of the published library carries it."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#licenseText",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The full text of a licence as its licensor publishes it, carried by the\nrecord itself. Curated records point at the authoritative text with cc:legalcode and quote\nsingle clauses in dalicc:WarrantyDisclaimer, dalicc:LiabilityLimitation and\ndalicc:additionalClauses; a composed licence may carry the text written for it, for example\nby License-to-Text after the licensor has checked it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "license text"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#legalcode"
      },
      {
        "@id": "https://dalicc.net/ns#additionalClauses"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Written by the DALICC license composer onto user-composed licenses; no license of the published library carries it."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#licenseVersion",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The version of the license text the record models, as the publisher numbers\nit, for example 2.0 or 3.0. It says nothing about the version of the DALICC model of that text,\nwhich dct:hasVersion carries."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "License version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/hasVersion"
      },
      {
        "@id": "https://dalicc.net/ns#jurisdictionPortOf"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by the 287 Creative Commons jurisdiction ports, whose parent is the 4.0 International record of the same element set, and by the two GNU records that always named their version."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#modificationNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A notice that indicates if the Assignee modified the Licensed Material and\nretains an indication of any previous modifications."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Modification notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/modify"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Providing a modification note means to document any changes done to the work and clearly document how it differs from the original work."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The dependency graph states that this action is included in odrl:AttachPolicy. It is the most frequent DALICC-proprietary action (539 occurrences in 320 licenses), always as an odrl:Duty."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#moralRightsNonAssertion",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The licensor undertaking not to assert the moral rights of the author\nagainst uses made under the license, so far as the applicable law allows."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Moral rights non-assertion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#moralRightsRestriction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 4 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#moralRightsRestriction",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Treating the work in a way that touches the moral rights of the author,\nsuch as false attribution or a derogatory treatment. Where the license binds the licensee to\nrespect those rights, this is the action it restricts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Moral rights restriction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Attribution"
      },
      {
        "@id": "https://dalicc.net/ns#moralRightsNonAssertion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 6 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#networkUseTrigger",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Making the work available over a network, deploying it or providing a service\nwith it. Where a license carries this term, that act triggers the duties the license would\notherwise attach to distribution, so the duties hang off this action rather than off\nodrl:distribute."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Network use trigger"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#ShareAlike"
      },
      {
        "@id": "http://creativecommons.org/ns#SourceCode"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap in the review records named in its scope note."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by 16 records whose texts make deployment or communication to the public a trigger: the Apple, Open Software, Reciprocal Public and Cryptographic Autonomy families and the two European Union Public Licence records."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#noWarrantyNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Informs that Licensed Material does not provide any warranties."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "No-warranty notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#WarrantyDisclaimer"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The licensee may attach a notice stating that the work is provided without warranty of any kind."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#orLaterVersionOption",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether the record models a license text that lets the licensee choose a\nlater version of the same license. False says the record models the named version only."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/Set"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Or later version option"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://purl.org/dc/terms/hasVersion"
      },
      {
        "@id": "https://dalicc.net/ns#ChangeLicense"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by the four GNU records, each with the value false: none of them models an or-later text."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#originalVersionOffer",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Giving every recipient of a modified work a way back to the original: the\nunmodified version itself, a difference file, or instructions for obtaining it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Original version offer"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#SourceCode"
      },
      {
        "@id": "https://dalicc.net/ns#modificationNotice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by IPA and OGTSL, whose texts require the original version, or the means of returning to it, to travel with the modified one."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#patentFree",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The license applies only to those patent claims licensable by such Contributor\nthat are necessarily infringed by their Contribution(s) alone or by combination of their\nContribution(s) with the Licensed Material to which such Contribution(s) was submitted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Patent free"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#patentNotice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "patentFree"
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#patentFreedomCondition",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The condition that a patent reading on the work must be licensed for free and\nunrestricted use by everyone, or else the work may not be distributed at all. It is the clause\nthat forbids a licensee to accept a patent license narrower than the license itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Patent freedom condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#addLimitation"
      },
      {
        "@id": "https://dalicc.net/ns#patentFree"
      },
      {
        "@id": "https://dalicc.net/ns#patentGrant"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 3 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by LGPL-2.0-only and LGPL-2.1-only (section 11, the liberty-or-death clause) and by OCLC-2.0."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#patentGrant",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An express license to the patent claims a contributor holds that the\ncontribution necessarily infringes. Modelled as a permission where the license text grants\nit; its absence means the license is silent about patents, not that patents are withheld."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Patent grant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#patentFree"
      },
      {
        "@id": "https://dalicc.net/ns#patentNotice"
      },
      {
        "@id": "https://dalicc.net/ns#patentRetaliationTermination"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 54 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#patentNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Notifies that Licensed Material is patented or includes patented parts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Patent notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "https://dalicc.net/ns#patentFree"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; used by 1 license record since 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#patentRetaliationTermination",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Bringing a patent claim over the licensed work. Where a license carries\nthis term, such a claim ends the patent license, or the whole license, as the text provides."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Patent retaliation termination"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#patentGrant"
      },
      {
        "@id": "https://dalicc.net/ns#terminationOnBreach"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the license library review of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 48 license records by the standard-license addition of 2026-09-15."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#permissionNotice",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The permission notices which are in the License shall be included."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Permission notice"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/AttachPolicy"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library; the library uses cc:Notice instead."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#perpetual",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://dalicc.net/ns#ValidityType"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A perpetual license allows to use the licensed work indefinitely."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Perpetual"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The license has no limit of time. Where this does not apply, a start date and an end date are given instead."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "en",
        "@value": "perpetual"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "The value of dalicc:validityType on 342 of 343 licenses."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#promote",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Assigner permits the Assignee to use the licensed work for promotional purposes.."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Promote"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://dalicc.net/ns#PromotionSpecification"
      },
      {
        "@id": "https://dalicc.net/ns#trademarkNotice"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Promote means that the licensee can use the licensor's trademark for advertising and promotion purposes."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Occurs 334 times in 332 licenses, almost always as an odrl:Prohibition: most licenses forbid trademark use."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#provideUserData",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Handing a recipient a no-charge copy, in a commonly used electronic form, of\nthe data about that recipient which the licensee holds because of the work."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Provide user data"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#SourceCode"
      },
      {
        "@id": "https://dalicc.net/ns#networkUseTrigger"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 2 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by the two Cryptographic Autonomy License records, whose section 4.2.1 is the clause the license is named for."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#publicationNonObstruction",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Restricting or deterring the ability of anyone who receives the work to\npublish it, or to record it and the grants of rights in it. Where this action is prohibited the\nlicensee may not stand between a recipient and publication."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Publication non-obstruction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      },
      {
        "@id": "https://dalicc.net/ns#addLimitation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 1 license record by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by CDLA-Sharing-1.0, whose section 3.3 forbids restricting or deterring publication of the data by a recipient."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#publish",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#RuleAction"
    ],
    "http://purl.org/dc/terms/source": [
      {
        "@id": "https://dalicc.github.io/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Assigner permits the Assignee to prepare and issue (a book, journal) for\npublic sale to make it generally known, to make available online."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Publish"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/present"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Defined in the 2022 documentation; not used by any license in the current library."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#recipientAssent",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Making a reasonable effort to obtain the express assent of a recipient to the\nterms of the license before the work reaches them, rather than relying on the notice alone."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Recipient assent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://creativecommons.org/ns#Notice"
      },
      {
        "@id": "http://www.w3.org/ns/odrl/2/distribute"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Added by the standard-license addition of 2026-09-15, which recorded the clause as a vocabulary gap. Applied to 6 license records by the standard-license addition of 2026-09-15."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Carried by the Academic Free and Open Software licenses from version 2.0 on, whose Attribution Rights clause asks for the express assent of recipients."
      }
    ]
  },
  {
    "@id": "https://dalicc.net/ns#recipientRegistrationRequest",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept",
      "http://www.w3.org/ns/odrl/2/Action",
      "https://dalicc.net/ns#DutyAction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Asking, without requiring, that a recipient register as a user of the work\nand report the modifications they make to it, so that the steward can keep a record."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
