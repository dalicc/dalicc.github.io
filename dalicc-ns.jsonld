  {
    "@id": "https://dalicc.net/ns#replacesRule",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a default rule of a graph built from another one to the rule of that other graph it takes the place of. The generated graph holds the replacing rule and not the replaced one, so no graph holds two default rules for one action and one territory."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://dalicc.net/ns#DefaultRule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://dalicc.net/ns#"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Replaces rule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://dalicc.net/ns#DefaultRule"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
